# NETLIFY ENVIRONMENT CONFIGURATION
# Deploy these as Netlify environment variables in the UI

# API ENDPOINTS
API_BASE=https://your-api.netlify.app
BACKEND_API=https://your-backend.example.com
LOCAL_LLM_ENABLED=true
LOCAL_LLM_ENDPOINT=https://your-ollama.example.com
LOCAL_LLM_MODEL=mistral

# DEVICE CONFIGURATION
DEVICE=cuda
GPU_MEMORY_LIMIT=0.8

# ENVIRONMENT FLAGS
XFORMERS_DISABLED=1
ORT_TENSORRT_UNAVAILABLE=1

# CORS CONFIGURATION (Update to your Netlify domain)
CORS_ORIGINS=https://your-netlify-site.netlify.app

# LLM CONFIGURATION
MISTRAL_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here (optional)

# DATABASE
DATABASE_URL=your_database_url_here

# MONITORING
ENABLE_MONITORING=true
LOG_LEVEL=INFO

# DEPLOYMENT
ENVIRONMENT=production
NODE_ENV=production
